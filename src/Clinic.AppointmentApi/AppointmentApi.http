@baseUrl = http://localhost:8080
@doctorId = 11111111-1111-1111-1111-111111111111
@slotId = 22222222-2222-2222-2222-222222222222
@appointmentId = 44444444-4444-4444-4444-444444444442

### List doctors
GET {{baseUrl}}/doctors

### List open slots for seeded cardiologist
GET {{baseUrl}}/doctors/{{doctorId}}/slots

### Book a seeded future slot
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "patientName": "Nguyen Test Patient",
  "patientPhone": "+84908887766",
  "doctorId": "{{doctorId}}",
  "timeSlotId": "{{slotId}}"
}

### Read a seeded appointment
GET {{baseUrl}}/appointments/{{appointmentId}}

### Read queue for today (override serviceDate to inspect seeded appointments for tomorrow)
GET {{baseUrl}}/queues/{{doctorId}}

### Advance queue (set serviceDate to the date returned by the slot endpoint)
POST {{baseUrl}}/queues/{{doctorId}}/next?serviceDate=2026-11-22

### Cancel a confirmed appointment (the seeded appointment may already be InProgress after advancing)
DELETE {{baseUrl}}/appointments/{{appointmentId}}

### Missing appointment returns 404
GET {{baseUrl}}/appointments/99999999-9999-9999-9999-999999999999

### Full or expired slot returns 409
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "patientName": "Test Patient",
  "patientPhone": "+84908887766",
  "doctorId": "{{doctorId}}",
  "timeSlotId": "99999999-9999-9999-9999-999999999999"
}
